package com.goldarzim.panel

import android.app.Notification
import android.app.NotificationChannel
import android.app.NotificationManager
import android.app.PendingIntent
import android.app.Service
import android.content.Context
import android.content.Intent
import android.graphics.Canvas
import android.graphics.Paint
import android.graphics.PixelFormat
import android.os.Build
import android.os.Handler
import android.os.IBinder
import android.os.Looper
import android.view.Gravity
import android.view.MotionEvent
import android.view.View
import android.view.WindowManager

class OverlayService : Service() {

    private var w: WindowManager? = null
    private var cross: Cross? = null
    private var hot: Hot? = null
    private var hp: WindowManager.LayoutParams? = null
    private var busy = false
    private var fg = false

    override fun onBind(i: Intent?): IBinder? = null

    override fun onCreate() {
        super.onCreate()
        w = getSystemService(Context.WINDOW_SERVICE) as WindowManager
        loadCfg()
    }

    override fun onStartCommand(i: Intent?, f: Int, id: Int): Int {
        startFg()
        syncCross()
        syncHot()
        return START_STICKY
    }

    override fun onDestroy() {
        saveCfg()
        release()
        super.onDestroy()
    }

    private fun release() {
        try { cross?.let { w?.removeView(it) } } catch (_: Throwable) {}
        try { hot?.let { w?.removeView(it) } } catch (_: Throwable) {}
        cross = null
        hot = null
        hp = null
    }

    private fun loadCfg() {
        val p = getSharedPreferences("g0", MODE_PRIVATE)
        Cfg.hx = p.getInt("hx", 0)
        Cfg.hy = p.getInt("hy", 0)
        Cfg.pos = p.getBoolean("pos", false)
    }

    private fun saveCfg() {
        getSharedPreferences("g0", MODE_PRIVATE).edit()
            .putInt("hx", Cfg.hx)
            .putInt("hy", Cfg.hy)
            .putBoolean("pos", Cfg.pos)
            .apply()
    }

    private fun startFg() {
        if (Build.VERSION.SDK_INT < 26) return
        val nm = getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
        if (nm.getNotificationChannel(CH) == null) {
            nm.createNotificationChannel(
                NotificationChannel(CH, "goldarzim_0", NotificationManager.IMPORTANCE_LOW)
            )
        }
        val pi = PendingIntent.getActivity(
            this, 0, Intent(this, MainActivity::class.java),
            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
        )
        val n = Notification.Builder(this, CH)
            .setSmallIcon(android.R.drawable.ic_menu_compass)
            .setContentTitle("goldarzim_0")
            .setContentText("mira na tela ativa")
            .setContentIntent(pi)
            .setOngoing(true)
            .build()
        try {
            if (!fg) {
                startForeground(1, n)
                fg = true
            } else {
                nm.notify(1, n)
            }
        } catch (_: Throwable) {}
    }

    private fun tipo(): Int =
        if (Build.VERSION.SDK_INT >= 26) WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY
        else @Suppress("DEPRECATION") WindowManager.LayoutParams.TYPE_PHONE

    private fun syncCross() {
        if (Cfg.overlayOn) {
            if (cross == null) {
                val v = Cross(this)
                val lp = WindowManager.LayoutParams(
                    WindowManager.LayoutParams.MATCH_PARENT,
                    WindowManager.LayoutParams.MATCH_PARENT,
                    tipo(),
                    WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
                        WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE or
                        WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN or
                        WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
                    PixelFormat.TRANSLUCENT
                )
                lp.gravity = Gravity.TOP or Gravity.START
                try { w?.addView(v, lp) } catch (_: Throwable) {}
                cross = v
            } else {
                cross?.invalidate()
            }
        } else {
            try { cross?.let { w?.removeView(it) } } catch (_: Throwable) {}
            cross = null
        }
    }

    private fun syncHot() {
        val dm = resources.displayMetrics
        if (Cfg.trick || Cfg.calib) {
            val bw = Cfg.hw.toInt().coerceAtLeast(60)
            val bh = Cfg.hh.toInt().coerceAtLeast(60)

            if (hot == null) {
                val v = Hot(this)
                val lp = WindowManager.LayoutParams(
                    bw, bh, tipo(),
                    WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
                        WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL or
                        WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN,
                    PixelFormat.TRANSLUCENT
                )
                lp.gravity = Gravity.TOP or Gravity.START

                if (!Cfg.pos) {
                    Cfg.hx = dm.widthPixels - bw - 30
                    Cfg.hy = dm.heightPixels - bh - 30
                    Cfg.pos = true
                }
                Cfg.hx = Cfg.hx.coerceIn(0, (dm.widthPixels - bw).coerceAtLeast(0))
                Cfg.hy = Cfg.hy.coerceIn(0, (dm.heightPixels - bh).coerceAtLeast(0))
                lp.x = Cfg.hx
                lp.y = Cfg.hy

                try { w?.addView(v, lp) } catch (_: Throwable) {}
                hp = lp
                hot = v
            } else {
                val lp = hp ?: return
                lp.width = bw
                lp.height = bh
                Cfg.hx = Cfg.hx.coerceIn(0, (dm.widthPixels - bw).coerceAtLeast(0))
                Cfg.hy = Cfg.hy.coerceIn(0, (dm.heightPixels - bh).coerceAtLeast(0))
                lp.x = Cfg.hx
                lp.y = Cfg.hy
                try { hot?.let { w?.updateViewLayout(it, lp) } } catch (_: Throwable) {}
                hot?.invalidate()
            }
            if (!busy) setTouchable(true)
        } else {
            try { hot?.let { w?.removeView(it) } } catch (_: Throwable) {}
            hot = null
            hp = null
        }
    }

    fun moveHot() {
        val lp = hp ?: return
        lp.x = Cfg.hx
        lp.y = Cfg.hy
        try { hot?.let { w?.updateViewLayout(it, lp) } } catch (_: Throwable) {}
    }

    fun snapHot() {
        val dm = resources.displayMetrics
        val bw = Cfg.hw.toInt().coerceAtLeast(60)
        val bh = Cfg.hh.toInt().coerceAtLeast(60)
        Cfg.hx = Cfg.hx.coerceIn(0, (dm.widthPixels - bw).coerceAtLeast(0))
        Cfg.hy = Cfg.hy.coerceIn(0, (dm.heightPixels - bh).coerceAtLeast(0))
        Cfg.pos = true
        saveCfg()
        moveHot()
    }

    private fun setTouchable(t: Boolean) {
        val lp = hp ?: return
        lp.flags = if (t) lp.flags and WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE.inv()
        else lp.flags or WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE
        try { hot?.let { w?.updateViewLayout(it, lp) } } catch (_: Throwable) {}
    }

    private fun fire(x: Float, y: Float) {
        if (busy) return
        val ts = TrickService.inst ?: return
        busy = true
        setTouchable(false)
        ts.trick(x, y, Cfg.dy, Cfg.ms) { done() }
    }

    private fun done() {
        Handler(Looper.getMainLooper()).post {
            busy = false
            if (Cfg.trick || Cfg.calib) setTouchable(true)
        }
    }

    inner class Cross(c: Context) : View(c) {
        private val p = Paint(Paint.ANTI_ALIAS_FLAG)
        override fun onDraw(canvas: Canvas) {
            if (!Cfg.overlayOn) return
            val cx = width / 2f
            val cy = height / 2f - height * (Cfg.off / 100f)
            val len = Cfg.tam * 4f
            val gap = Cfg.tam
            p.color = Cfg.cor
            p.style = Paint.Style.STROKE
            p.strokeWidth = Cfg.esp.toFloat()
            canvas.drawLine(cx - len, cy, cx - gap, cy, p)
            canvas.drawLine(cx + gap, cy, cx + len, cy, p)
            canvas.drawLine(cx, cy - len, cx, cy - gap, p)
            canvas.drawLine(cx, cy + gap, cx, cy + len, p)
            p.style = Paint.Style.FILL
            canvas.drawCircle(cx, cy, (Cfg.tam * 0.45f).coerceAtLeast(1f), p)
        }
    }

    inner class Hot(c: Context) : View(c) {
        private val p = Paint(Paint.ANTI_ALIAS_FLAG)
        private var dragging = false
        private var sx = 0f
        private var sy = 0f
        private var ox = 0f
        private var oy = 0f

        init { isClickable = true }

        override fun onTouchEvent(e: MotionEvent): Boolean {
            when (e.actionMasked) {
                MotionEvent.ACTION_DOWN -> {
                    if (Cfg.calib) {
                        dragging = true
                        sx = e.rawX
                        sy = e.rawY
                        ox = Cfg.hx.toFloat()
                        oy = Cfg.hy.toFloat()
                    } else {
                        fire(e.rawX, e.rawY)
                    }
                    invalidate()
                }
                MotionEvent.ACTION_MOVE -> {
                    if (dragging) {
                        Cfg.hx = (ox + e.rawX - sx).toInt()
                        Cfg.hy = (oy + e.rawY - sy).toInt()
                        moveHot()
                        invalidate()
                    }
                }
                MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
                    if (dragging) {
                        dragging = false
                        snapHot()
                        invalidate()
                    }
                }
            }
            return true
        }

        override fun onDraw(canvas: Canvas) {
            if (!Cfg.calib) return
            val wf = width.toFloat()
            val hf = height.toFloat()
            p.style = Paint.Style.FILL
            p.color = 0x2200FF5A
            canvas.drawRoundRect(0f, 0f, wf, hf, 20f, 20f, p)
            p.style = Paint.Style.STROKE
            p.strokeWidth = 3f
            p.color = 0xFF00FF5A.toInt()
            canvas.drawRoundRect(1.5f, 1.5f, wf - 1.5f, hf - 1.5f, 20f, 20f, p)
            val cx = wf / 2f
            val cy = hf / 2f
            p.strokeWidth = 2f
            canvas.drawLine(cx - 20f, cy, cx + 20f, cy, p)
            canvas.drawLine(cx, cy - 20f, cx, cy + 20f, p)
        }
    }

    companion object {
        private const val CH = "g0"
    }
}


