package com.goldarzim.panel

import android.annotation.SuppressLint
import android.app.Activity
import android.content.ClipData
import android.content.ClipboardManager
import android.content.Context
import android.content.Intent
import android.graphics.Color
import android.net.Uri
import android.os.Build
import android.os.Bundle
import android.provider.Settings
import android.view.View
import android.view.WindowManager
import android.webkit.JavascriptInterface
import android.webkit.WebView
import android.webkit.WebViewClient
import android.widget.Toast
import java.io.File

class MainActivity : Activity() {

    private lateinit var web: WebView

    @SuppressLint("SetJavaScriptEnabled")
    override fun onCreate(s: Bundle?) {
        super.onCreate(s)
        window.addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)
        fullscreen()

        if (Build.VERSION.SDK_INT >= 33) {
            try {
                requestPermissions(arrayOf("android.permission.POST_NOTIFICATIONS"), 7)
            } catch (_: Throwable) {}
        }

        web = WebView(this)
        setContentView(web)

        web.settings.apply {
            javaScriptEnabled = true
            domStorageEnabled = true
            allowFileAccess = true
            allowContentAccess = true
            mediaPlaybackRequiresUserGesture = false
            textZoom = 100
        }
        web.setBackgroundColor(0xFF0B0D11.toInt())
        web.isVerticalScrollBarEnabled = false
        web.isHorizontalScrollBarEnabled = false
        web.overScrollMode = View.OVER_SCROLL_NEVER
        web.webViewClient = WebViewClient()
        web.addJavascriptInterface(Bridge(), "gold")
        web.loadUrl("file:///android_asset/index.html")

        if (!canOverlay()) askOverlay()
    }

    override fun onResume() {
        super.onResume()
        fullscreen()
    }

    @Suppress("DEPRECATION")
    private fun fullscreen() {
        window.decorView.systemUiVisibility =
            View.SYSTEM_UI_FLAG_LAYOUT_STABLE or
            View.SYSTEM_UI_FLAG_LAYOUT_HIDE_NAVIGATION or
            View.SYSTEM_UI_FLAG_LAYOUT_FULLSCREEN or
            View.SYSTEM_UI_FLAG_HIDE_NAVIGATION or
            View.SYSTEM_UI_FLAG_FULLSCREEN or
            View.SYSTEM_UI_FLAG_IMMERSIVE_STICKY
    }

    private fun canOverlay(): Boolean = try {
        Settings.canDrawOverlays(this)
    } catch (_: Throwable) {
        false
    }

    private fun askOverlay() {
        try {
            startActivity(
                Intent(Settings.ACTION_MANAGE_OVERLAY_PERMISSION, Uri.parse("package:$packageName"))
            )
        } catch (_: Throwable) {
            try {
                startActivity(Intent(Settings.ACTION_MANAGE_OVERLAY_PERMISSION))
            } catch (_: Throwable) {}
        }
    }

    private fun accOn(): Boolean = try {
        val s = Settings.Secure.getString(
            contentResolver, Settings.Secure.ENABLED_ACCESSIBILITY_SERVICES
        ) ?: ""
        s.contains(packageName) && s.contains("TrickService")
    } catch (_: Throwable) {
        false
    }

    private fun openAcc() {
        try {
            startActivity(Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS))
        } catch (_: Throwable) {
            toast("Acessibilidade > goldarzim_0")
        }
    }

    private fun start() {
        val i = Intent(this, OverlayService::class.java)
        try {
            if (Build.VERSION.SDK_INT >= 26) startForegroundService(i) else startService(i)
        } catch (_: Throwable) {
            try { startService(i) } catch (_: Throwable) {}
        }
    }

    private fun stop() {
        try { stopService(Intent(this, OverlayService::class.java)) } catch (_: Throwable) {}
    }

    private fun toast(m: String) {
        try { Toast.makeText(this, m, Toast.LENGTH_SHORT).show() } catch (_: Throwable) {}
    }

    @Suppress("DEPRECATION")
    override fun onBackPressed() {
        if (web.canGoBack()) web.goBack() else moveTaskToBack(true)
    }

    inner class Bridge {

        @JavascriptInterface
        fun state(): String {
            val o = if (canOverlay()) "1" else "0"
            val a = if (accOn()) "1" else "0"
            return "$o$a"
        }

        @JavascriptInterface
        fun overlay(on: Boolean, cor: String, esp: Int, off: Float, tam: Int) {
            runOnUiThread {
                Cfg.overlayOn = on
                Cfg.cor = try { Color.parseColor(cor) } catch (_: Throwable) { 0xFF00FF5A.toInt() }
                Cfg.esp = esp.coerceIn(1, 12)
                Cfg.off = off.coerceIn(-20f, 30f)
                Cfg.tam = tam.toFloat().coerceIn(2f, 40f)
                if (on || Cfg.trick || Cfg.calib) start() else stop()
            }
        }

        @JavascriptInterface
        fun trick(on: Boolean, dy: Float, ms: Int, w: Float, h: Float, calib: Boolean) {
            runOnUiThread {
                Cfg.trick = on
                Cfg.calib = calib
                Cfg.dy = dy.coerceIn(10f, 600f)
                Cfg.ms = ms.toLong().coerceIn(20L, 600L)
                Cfg.hw = w.coerceIn(60f, 900f)
                Cfg.hh = h.coerceIn(60f, 900f)
                if (on || calib || Cfg.overlayOn) start() else stop()
            }
        }

        @JavascriptInterface
        fun hide() {
            runOnUiThread { moveTaskToBack(true) }
        }

        @JavascriptInterface
        fun accSettings() {
            runOnUiThread { openAcc() }
        }

        @JavascriptInterface
        fun overlaySettings() {
            runOnUiThread { askOverlay() }
        }

        @JavascriptInterface
        fun copy(txt: String) {
            runOnUiThread {
                try {
                    val cm = getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager
                    cm.setPrimaryClip(ClipData.newPlainText("goldarzim_0", txt))
                    toast("copiado")
                } catch (_: Throwable) {
                    toast("falha ao copiar")
                }
            }
        }

        @JavascriptInterface
        fun save(nome: String, txt: String) {
            try {
                val dir = getExternalFilesDir(null) ?: filesDir
                val f = File(dir, nome)
                f.writeText(txt)
                runOnUiThread { toast("salvo em " + f.absolutePath) }
            } catch (e: Throwable) {
                runOnUiThread { toast("falha: " + e.message) }
            }
        }
    }
}


