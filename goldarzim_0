package com.goldarzim.panel

import android.accessibilityservice.AccessibilityService
import android.accessibilityservice.GestureDescription
import android.graphics.Path
import android.view.accessibility.AccessibilityEvent

class TrickService : AccessibilityService() {

    override fun onServiceConnected() {
        inst = this
    }

    override fun onAccessibilityEvent(e: AccessibilityEvent?) {}

    override fun onInterrupt() {}

    override fun onDestroy() {
        if (inst === this) inst = null
        super.onDestroy()
    }

    fun trick(x: Float, y: Float, dy: Float, ms: Long, done: () -> Unit) {
        val path = Path()
        path.moveTo(x, y)
        path.lineTo(x, y - dy)

        val dur = ms.coerceIn(20L, 600L)
        val g = GestureDescription.Builder()
            .addStroke(GestureDescription.StrokeDescription(path, 0L, dur))
            .build()

        val cb = object : AccessibilityService.GestureResultCallback() {
            override fun onCompleted(d: GestureDescription?) = done()
            override fun onCancelled(d: GestureDescription?) = done()
        }

        val ok = try {
            dispatchGesture(g, cb, null)
        } catch (_: Throwable) {
            false
        }
        if (!ok) done()
    }

    companion object {
        @Volatile var inst: TrickService? = null
    }
}


