  --bg:#0b0d11;--card:#12151b;--line:#242a36;--tx:#e8ecf3;--dim:#8b94a6;--ok:#00ff5a;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;background:var(--bg);color:var(--tx);
  font:14px/1.4 Roboto,-apple-system,"Segoe UI",sans-serif;
  overscroll-behavior:none;-webkit-user-select:none;user-select:none}
#hd{position:sticky;top:0;z-index:9;display:flex;align-items:center;justify-content:space-between;
  gap:8px;padding:calc(8px + env(safe-area-inset-top)) 12px 8px;
  background:#0b0d11ee;border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:8px;font-weight:800;letter-spacing:.5px;font-size:15px}
.brand .dot{width:9px;height:9px;border-radius:50%;background:var(--ok);box-shadow:0 0 10px var(--ok)}
.pills{display:flex;gap:6px;flex-wrap:wrap}
.pill{font-size:10px;letter-spacing:.6px;padding:4px 8px;border-radius:99px;
  border:1px solid var(--line);color:var(--dim);background:#0f131a;font-weight:700}
.pill.act{border-color:var(--ok);color:var(--ok)}
#bd{padding:12px 12px 130px;display:flex;flex-direction:column;gap:12px;
  max-width:760px;margin:0 auto}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:12px;
  display:flex;flex-direction:column;gap:10px}
.ch{display:flex;align-items:center;justify-content:space-between;gap:8px}
.ch h2{margin:0;font-size:12px;letter-spacing:1.4px;text-transform:uppercase;color:var(--dim)}
.tg{min-width:66px;padding:8px 12px;border-radius:10px;border:1px solid var(--line);
  background:#0f131a;color:var(--dim);font-weight:800;font-size:12px;letter-spacing:.5px}
.tg.act{background:var(--ok);border-color:var(--ok);color:#04140a}
.rw{display:flex;align-items:center;justify-content:space-between;gap:10px}
.rw>span{font-size:12px;color:var(--dim)}
.sw{display:flex;gap:8px}
.sw i{width:26px;height:26px;border-radius:8px;border:2px solid #2b3240;display:block}
.sw i.on{border-color:#fff}
.sl{display:grid;grid-template-columns:96px 1fr 56px;align-items:center;gap:8px}
.sl>span{font-size:12px;color:var(--dim)}
.sl>b{font-size:12px;text-align:right;font-variant-numeric:tabular-nums}
input[type=range]{-webkit-appearance:none;width:100%;height:26px;background:transparent}
input[type=range]::-webkit-slider-runnable-track{height:5px;border-radius:99px;background:#242a36}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:20px;height:20px;margin-top:-8px;
  border-radius:50%;background:var(--ok);border:2px solid #0b0d11}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.bt{padding:11px;border-radius:11px;border:1px solid var(--line);background:#0f131a;
  color:var(--tx);font-weight:700;font-size:13px}
.bt.act{border-color:var(--ok);color:var(--ok)}
.bt.pri{background:var(--ok);border-color:var(--ok);color:#04140a}
.dpi{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}
.hint{margin:0;font-size:11px;color:var(--dim);line-height:1.5}
#ficha{margin:0;padding:10px;background:#0d1015;border:1px solid var(--line);border-radius:10px;
  font:11px/1.6 ui-monospace,Menlo,Consolas,monospace;color:#b9c3d4;
  white-space:pre-wrap;word-break:break-word;max-height:190px;overflow:auto}
#ft{position:fixed;left:0;right:0;bottom:0;z-index:9;display:grid;
  grid-template-columns:1fr 1fr 1fr;gap:8px;
  padding:10px 12px calc(10px + env(safe-area-inset-bottom));
  background:#0b0d11f2;border-top:1px solid var(--line);max-width:760px;margin:0 auto}
#toast{position:fixed;left:50%;bottom:100px;transform:translate(-50%,14px);
  background:#1a202b;border:1px solid var(--line);padding:9px 14px;border-radius:99px;
  font-size:12px;font-weight:600;opacity:0;pointer-events:none;transition:.18s;z-index:20}
#toast.on{opacity:1;transform:translate(-50%,0)}
</style>
</head>
<body>

<header id="hd">
  <div class="brand"><span class="dot"></span>goldarzim_0</div>
  <div class="pills">
    <span class="pill" id="pX">XIT off</span>
    <span class="pill" id="pA">A11Y ?</span>
    <span class="pill" id="pO">OVL ?</span>
  </div>
</header>

<main id="bd">

  <section class="card">
    <div class="ch"><h2>Mira</h2><button class="tg" id="bOv">off</button></div>
    <div class="rw"><span>Cor</span><div class="sw" id="sw"></div></div>
    <label class="sl"><span>Espessura</span><input type="range" id="sEsp" min="1" max="8" step="1"><b id="vEsp">2</b></label>
    <label class="sl"><span>Offset</span><input type="range" id="sOff" min="-10" max="20" step="0.5"><b id="vOff">2.0</b></label>
    <label class="sl"><span>Tamanho</span><input type="range" id="sTam" min="4" max="20" step="1"><b id="vTam">8</b></label>
  </section>

  <section class="card">
    <div class="ch"><h2>Headtrick</h2><button class="tg" id="bTk">off</button></div>
    <label class="sl"><span>Arrasto</span><input type="range" id="sDy" min="40" max="320" step="5"><b id="vDy">140px</b></label>
    <label class="sl"><span>Duracao</span><input type="range" id="sMs" min="20" max="300" step="5"><b id="vMs">80ms</b></label>
    <div class="grid2">
      <label class="sl"><span>Caixa L</span><input type="range" id="sW" min="120" max="520" step="10"><b id="vW">280px</b></label>
      <label class="sl"><span>Caixa A</span><input type="range" id="sH" min="120" max="520" step="10"><b id="vH">300px</b></label>
    </div>
    <button class="bt" id="bCal">Calibrar posicao</button>
    <p class="hint">A caixa fica sobre o botao de tiro. Um toque = um tiro com arrasto ate a cabeca.
    Com a acessibilidade desligada a caixa engole o toque.</p>
  </section>

  <section class="card">
    <div class="ch"><h2>Sensi</h2><span class="pill">referencia</span></div>
    <div id="ss"></div>
  </section>

  <section class="card">
    <div class="ch"><h2>DPI</h2></div>
    <div class="dpi">
      <button class="bt" data-dpi="450">450</button>
      <button class="bt" data-dpi="520">520</button>
      <button class="bt" data-dpi="600">600</button>
      <button class="bt" data-dpi="720">720</button>
      <button class="bt" data-dpi="840">840</button>
    </div>
  </section>

  <section class="card">
    <div class="ch"><h2>Ficha</h2></div>
    <pre id="ficha"></pre>
    <div class="grid2">
      <button class="bt" id="bCp">Copiar ficha</button>
      <button class="bt" id="bDl">Salvar .txt</button>
    </div>
  </section>

</main>

<footer id="ft">
  <button class="bt pri" id="bHd">Ocultar</button>
  <button class="bt" id="bAcc">Acessibilidade</button>
  <button class="bt" id="bOvs">Permissao</button>
</footer>

<div id="toast"></div>

<script>
(function(){
  "use strict";

  var $  = function(s){ return document.querySelector(s); };
  var $$ = function(s){ return Array.prototype.slice.call(document.querySelectorAll(s)); };
  var BR = (typeof window.gold !== "undefined");
  var KEY = "g0cfg";

  var CORES = ["#00ff5a","#ff2d2d","#00b0ff","#ffd400","#ff00e6","#ffffff"];
  var SEN = [
    {k:"ger", n:"Geral"},
    {k:"rd",  n:"Ponto vermelho"},
    {k:"x2",  n:"Mira 2x"},
    {k:"x4",  n:"Mira 4x"},
    {k:"awm", n:"Sniper"},
    {k:"fl",  n:"Free look"}
  ];

  var DEF = {
    ov:false, cor:"#00ff5a", esp:2, off:2, tam:8,
    tk:false, dy:140, ms:80, w:280, h:300, cal:false,
    sn:{ger:90, rd:85, x2:80, x4:75, awm:60, fl:95},
    dpi:600
  };

  var st = JSON.parse(JSON.stringify(DEF));

  function save(){
    try { localStorage.setItem(KEY, JSON.stringify(st)); } catch(e){}
  }

  function load(){
    try {
      var r = localStorage.getItem(KEY);
      if(!r) return;
      var o = JSON.parse(r);
      for(var k in DEF){ if(o[k] !== undefined) st[k] = o[k]; }
      st.sn = Object.assign({}, DEF.sn, o.sn || {});
    } catch(e){}
  }

  var tmr;
  function toast(m){
    var t = $("#toast");
    t.textContent = m;
    t.classList.add("on");
    clearTimeout(tmr);
    tmr = setTimeout(function(){ t.classList.remove("on"); }, 1500);
  }

  function pushOv(){
    if(BR) window.gold.overlay(!!st.ov, st.cor, +st.esp, +st.off, +st.tam);
  }

  function pushTk(){
    if(BR) window.gold.trick(!!st.tk, +st.dy, +st.ms, +st.w, +st.h, !!st.cal);
  }

  function ficha(){
    return [
      "goldarzim_0 - ficha",
      "mira: " + (st.ov ? "on" : "off") + " | cor " + st.cor +
        " | esp " + st.esp + " | off " + (+st.off).toFixed(1) + " | tam " + st.tam,
      "headtrick: " + (st.tk ? "on" : "off") + " | arrasto " + st.dy +
        " | dur " + st.ms + "ms | caixa " + st.w + "x" + st.h,
      "sensi: " + SEN.map(function(s){ return s.n + " " + st.sn[s.k]; }).join(" | "),
      "dpi: " + st.dpi
    ].join("\n");
  }

  function upd(){
    $("#bOv").textContent = st.ov ? "on" : "off";
    $("#bOv").classList.toggle("act", !!st.ov);
    $("#bTk").textContent = st.tk ? "on" : "off";
    $("#bTk").classList.toggle("act", !!st.tk);
    $("#bCal").classList.toggle("act", !!st.cal);
    $("#bCal").textContent = st.cal ? "Calibrando..." : "Calibrar posicao";

    $("#vEsp").textContent = st.esp;
    $("#vOff").textContent = (+st.off).toFixed(1);
    $("#vTam").textContent = st.tam;
    $("#vDy").textContent  = st.dy + "px";
    $("#vMs").textContent  = st.ms + "ms";
    $("#vW").textContent   = st.w + "px";
    $("#vH").textContent   = st.h + "px";

    $("#sEsp").value = st.esp;
    $("#sOff").value = st.off;
    $("#sTam").value = st.tam;
    $("#sDy").value  = st.dy;
    $("#sMs").value  = st.ms;
    $("#sW").value   = st.w;
    $("#sH").value   = st.h;

    $$("#sw i").forEach(function(e){ e.classList.toggle("on", e.dataset.c === st.cor); });
    $$(".sn").forEach(function(e){
      var k = e.dataset.k;
      e.querySelector("b").textContent = st.sn[k];
      e.querySelector("input").value = st.sn[k];
    });
    $$("[data-dpi]").forEach(function(b){
      b.classList.toggle("act", +b.dataset.dpi === +st.dpi);
    });

    var on = !!(st.tk || st.ov);
    $("#pX").textContent = "XIT " + (on ? "on" : "off");
    $("#pX").classList.toggle("act", on);

    $("#ficha").textContent = ficha();
    save();
  }

  function stt(){
    if(!BR){
      $("#pA").textContent = "A11Y web";
      $("#pO").textContent = "OVL web";
      return;
    }
    var s = "00";
    try { s = String(window.gold.state()); } catch(e){}
    var o = s.charAt(0) === "1";
    var a = s.charAt(1) === "1";
    $("#pA").textContent = "A11Y " + (a ? "ok" : "off");
    $("#pA").classList.toggle("act", a);
    $("#pO").textContent = "OVL " + (o ? "ok" : "off");
    $("#pO").classList.toggle("act", o);
  }

  function bind(id, k){
    var e = $(id);
    e.addEventListener("input", function(){
      st[k] = +e.value;
      upd();
      pushOv();
      pushTk();
    });
  }

  CORES.forEach(function(c){
    var i = document.createElement("i");
    i.dataset.c = c;
    i.style.background = c;
    i.addEventListener("click", function(){
      st.cor = c;
      upd();
      pushOv();
    });
    $("#sw").appendChild(i);
  });

  SEN.forEach(function(s){
    var l = document.createElement("label");
    l.className = "sl sn";
    l.dataset.k = s.k;
    l.innerHTML = "<span>" + s.n + "</span><input type=\"range\" min=\"0\" max=\"200\" step=\"1\"><b></b>";
    l.querySelector("input").addEventListener("input", function(ev){
      st.sn[s.k] = +ev.target.value;
      upd();
    });
    $("#ss").appendChild(l);
  });

  bind("#sEsp", "esp");
  bind("#sOff", "off");
  bind("#sTam", "tam");
  bind("#sDy",  "dy");
  bind("#sMs",  "ms");
  bind("#sW",   "w");
  bind("#sH",   "h");

  $("#bOv").addEventListener("click", function(){ st.ov = !st.ov; upd(); pushOv(); });
  $("#bTk").addEventListener("click", function(){ st.tk = !st.tk; upd(); pushTk(); });
  $("#bCal").addEventListener("click", function(){ st.cal = !st.cal; upd(); pushTk(); });

  $$("[data-dpi]").forEach(function(b){
    b.addEventListener("click", function(){ st.dpi = +b.dataset.dpi; upd(); });
  });

  $("#bCp").addEventListener("click", function(){
    var t = $("#ficha").textContent;
    if(BR && window.gold.copy){ window.gold.copy(t); return; }
    if(navigator.clipboard && navigator.clipboard.writeText){
      navigator.clipboard.writeText(t).then(
        function(){ toast("ficha copiada"); },
        function(){ toast("falha ao copiar"); }
      );
      return;
    }
    toast("copie manualmente");
  });

  $("#bDl").addEventListener("click", function(){
    var t = $("#ficha").textContent;
    if(BR && window.gold.save){ window.gold.save("goldarzim_0_ficha.txt", t); return; }
    try {
      var a = document.createElement("a");
      a.href = URL.createObjectURL(new Blob([t], {type:"text/plain"}));
      a.download = "goldarzim_0_ficha.txt";
      document.body.appendChild(a);
      a.click();
      a.remove();
      toast("download");
    } catch(e){ toast("falha ao salvar"); }
  });

  $("#bHd").addEventListener("click", function(){ if(BR) window.gold.hide(); else toast("so no app"); });
  $("#bAcc").addEventListener("click", function(){ if(BR) window.gold.accSettings(); else toast("so no app"); });
  $("#bOvs").addEventListener("click", function(){ if(BR) window.gold.overlaySettings(); else toast("so no app"); });

  document.addEventListener("contextmenu", function(e){ e.preventDefault(); });

  load();
  upd();
  pushOv();
  pushTk();
  stt();
  setInterval(stt, 2000);
})();
</script>
</body>
</html>


=====[ .github/workflows/build.yml ]=====
name: build

on:
  push:
    branches: [ main, master ]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  apk:
    runs-on: ubuntu-latest
    timeout-minutes: 25

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Android SDK
        uses: android-actions/setup-android@v3

      - name: Gradle 8.7
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.7'

      - name: Build debug APK
        run: gradle assembleDebug --no-daemon --stacktrace

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: goldarzim_0-apk
          path: app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
